# ── Database (Neon) ──────────────────────────────────────────────
# Pooled connection string — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string — used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth (Clerk — Organizations MUST be enabled in the Clerk dashboard) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ── AI (Anthropic — server-side only, never exposed to the browser) ──
ANTHROPIC_API_KEY="sk-ant-..."

# ── File storage (Vercel Blob) ───────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Background jobs (Vercel Cron) ────────────────────────────────
# Shared secret checked by /api/cron/* handlers (read from Phase 8's
# prospecting cron onward). Generate with:
#   openssl rand -hex 32
CRON_SECRET="change-me"

# ── Prospecting / lead sourcing (Phase 8 — server-side only) ─────
# KEYLESS AGENTS — these run with no configuration at all:
#   fda         openFDA drug approvals
#   fda_device  openFDA 510(k) device clearances
#   osm         OpenStreetMap via Overpass (needs a market centre in
#               Settings → Prospecting, not a key)
# openFDA needs no key; a key only raises the rate limit.
OPENFDA_API_KEY=""
# Google Places is the one PAID discovery source. Unset → agent skipped
# with a reason; OSM covers the same ground for free.
GOOGLE_PLACES_API_KEY=""
# Optional: raises Socrata's per-IP rate limit for municipal permit
# feeds. The permit agent works without it — the feed URL, field mapping
# and required termsUrl live per-org in Organization.settings.
SOCRATA_APP_TOKEN=""
# Apollo enrichment. Unset → stub provider, no paid calls.
APOLLO_API_KEY=""
# Budget caps — belt and braces against a connector that ignores its limit.
PROSPECT_MAX_PER_RUN="200"
PROSPECT_ENRICH_MAX_PER_RUN="10"
PROSPECT_MIN_SCORE_TO_ENRICH="60"
# Optional MCP-native source (static URL + bearer). Unset → source skipped.
PROSPECT_MCP_URL=""
PROSPECT_MCP_TOKEN=""

# ── Notifications (Phase 6 — email wired first, SMS stubbed) ─────
RESEND_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
