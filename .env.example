# ── Database (Neon) ──────────────────────────────────────────────
# Pooled connection string — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string — used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth (Clerk — Organizations MUST be enabled in the Clerk dashboard) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ── AI (Anthropic — server-side only, never exposed to the browser) ──
ANTHROPIC_API_KEY="sk-ant-..."

# ── File storage (Vercel Blob) ───────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Background jobs (Vercel Cron) ────────────────────────────────
# Shared secret checked by /api/cron/* handlers. Generate with:
#   openssl rand -hex 32
CRON_SECRET="change-me"

# ── Notifications (Phase 6 — email wired first, SMS stubbed) ─────
RESEND_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
